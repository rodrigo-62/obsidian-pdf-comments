{
	"name": "obsidian-pdf-comments",
	"version": "0.1.0",
	"private": true,
	"description": "PDF Comments: margin comments on PDFs in Obsidian",
	"main": "main.js",
	"type": "module",
	"scripts": {
		"dev": "node esbuild.config.mjs",
		"build": "tsc -noEmit -skipLibCheck && node esbuild.config.mjs production",
		"test": "vitest run",
		"test:watch": "vitest",
		"typecheck": "tsc -noEmit -skipLibCheck",
		"version": "node version-bump.mjs && git add manifest.json versions.json",
		"vault:reset": "node scripts/build-test-vault.mjs",
		"lint": "eslint ."
	},
	"license": "MIT",
	"devDependencies": {
		"@eslint/js": "^10.0.1",
		"@types/node": "^22.20.5",
		"esbuild": "^0.28.2",
		"eslint": "^10.15.0",
		"eslint-plugin-obsidianmd": "^0.6.0",
		"globals": "^17.14.0",
		"happy-dom": "^21.0.4",
		"jiti": "^2.7.0",
		"obsidian": "^1.14.4",
		"tslib": "^2.9.1",
		"typescript": "~6.0",
		"typescript-eslint": "^8.73.0",
		"vitest": "^5.1.1"
	}
}
